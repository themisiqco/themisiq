+const text = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ')
+
+describe('FigureInput', () => {
+  it('typed: an editable input and nothing else', () => {
+    const h = draw({ ...emptyLocation('L1', 'Site A'), natural_gas_amount: 40 })
