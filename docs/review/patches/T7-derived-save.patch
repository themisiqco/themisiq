+    const reopened = inv(saved.map(l => ({ ...l, source_docs: l.source_docs.map(d => ({ ...d, extracted: d.extracted!.map(p => ({ ...p, status: 'rejected' as const })) })) })))
+    expect(figuresForSave(reopened, 'AR6').totals.s1_total).toBe(0)
+  })
+})
